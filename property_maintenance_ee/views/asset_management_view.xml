<odoo>

    <!-- Asset : Form -->
    <record id="prop_maintenance_button_count" model="ir.ui.view">
        <field name="name">account.asset.maintenance.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="property_management_ee.property_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_inline oe_stat_button" name="open_maintenance" type="object" icon="fa-wrench">
                    <field string="Maintenance" name="maint_request" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" name="open_equipment" type="object" icon="fa-cogs">
                    <field string="Equipment" name="equipment_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="prop_maintenance_net_income" model="ir.ui.view">
        <field name="name">account.asset.maintenance.net.income</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="property_management_ee.property_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='roi']" position="after">
                <field name="maintenance_cost_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="net_income" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
