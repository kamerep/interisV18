<odoo>

    <!-- maintenance Kanban view Inherited -->
    <record id="maintenance_request_equipment_view_kanban_id" model="ir.ui.view">
        <field name="name">property.maintenance.request.kanban</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/field[@name='name']" position="after">
                <span t-if="record.property_id.raw_value" class="text-muted">
                    <i class="fa fa-building-o me-1" title="Property"/><field name="property_id"/>
                </span>
                <span t-if="record.tenant_id.raw_value">
                    <i class="fa fa-user me-1" title="Tenant"/><field name="tenant_id"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Request : views -->
    <record id="maintenance_request_form_view_Inherit" model="ir.ui.view">
        <field name="name">property.maintenance.form</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='reset_equipment_request']" position="after">
                <button name="create_invoice" string="Create Invoice" type="object" class="btn-primary" invisible="invoice_check or not done"/>
                <button name="open_invoice" string="Open Invoice" type="object" class="btn-primary" invisible="not invoice_check and not invoice_id"/>
            </xpath>
            
            <field name='equipment_id' position='before'>
                <field name='property_id' context="{'list_view_ref': 'property_management_ee.property_view_asset_tree', 'form_view_ref':'property_management_ee.property_asset_form'}"/>
            </field>
            <field name='equipment_id' position='attributes'>
                <attribute name="domain">['|', ('property_id', '=', False), ('property_id', '=', property_id)]</attribute>
                <attribute name="context">{'default_company_id': company_id, 'default_category_id': category_id, 'default_property_id': property_id}</attribute>
            </field>
            <button name='archive_equipment_request' position='after'>
                <button name="open_google_map" string="Get Location"
                invisible="not street"
                type="object" icon="fa-location-arrow" colspan="2" class="oe_inline oe_stat_button oe_highlight"/>
            </button> 
            <field name="maintenance_type" position="after">
                <field name="tenant_id"/>
            </field>
            <field name="priority" position="before">
                <field name="cost" string="Cost" class="oe_inline" readonly="done"/>
                <field name="renters_fault" readonly="done"/>
                <field name='invoice_id' readonly='True'/>
                <field name='date_invoice' readonly='True'/>
                <field name="done" invisible="1"/>
                <field name="invoice_check" invisible="1"/>
                <field name="is_in_progress" invisible="1"/>
                <field name='company_currency_id' invisible='1'/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Property Details" name="property_details">
                    <group>
                        <group string="Property Address">
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" class="o_address_street" placeholder="Street..."/>
                                <field name="street2" class="o_address_street" placeholder="Street 2..."/>
                                <field name="township" class="o_address_street" placeholder="Township..."/>
                                <field name="city" class="o_address_city" placeholder="City"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True}"/>
                                <field name="zip" class="o_address_zip" placeholder="ZIP"/>
                                <field name="country_id" class="o_address_country" placeholder="Country" options="{'no_open': True, 'no_create': True}"/>
                            </div>
                        </group>
                        <group string="Accounting">
                            <field name="account_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">done</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_team_id']" position="attributes">
                <attribute name="readonly">done</attribute>
            </xpath>
            <xpath expr="//field[@name='schedule_date']" position="attributes">
                <attribute name="readonly">done</attribute>
            </xpath>
            <xpath expr="//field[@name='duration']" position="attributes">
                <attribute name="readonly">done</attribute>
            </xpath>
            <xpath expr="//field[@name='request_date']" position="attributes">
                <attribute name="readonly">done</attribute>
            </xpath>
            <xpath expr="//field[@name='close_date']" position="attributes">
                <attribute name="readonly">done</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">done</attribute>
            </xpath>
        </field>
    </record>

    <menuitem
        id="maintenance.menu_maintenance_title"
        name="Property Maintenance"
        web_icon="maintenance,static/description/icon.png"
        sequence="110"
        groups="maintenance.group_equipment_manager,property_maintenance_ee.groups_property_maintenance_manager,property_maintenance_ee.groups_property_maintenance_worker"/>


    <record id="maintenance_request_stage_tree_view_Inherit" model="ir.ui.view">
        <field name="name">property.maintenance.stage.tree</field>
        <field name="model">maintenance.stage</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_stage_view_tree"/>
        <field name="arch" type="xml">
            <field name ='done' position='after'>
                <field name = 'is_in_progress'/>
            </field>
        </field>
    </record>

    <record id="maintenance_request_tree_view_inherit" model="ir.ui.view">
        <field name="name">property.maintenance.tree.view</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <!-- <field name="owner_user_id" invisible="True"/> -->
            <field name="category_id" position="replace"/>
            <field name ='user_id' position='attributes'>
                <attribute name="string">Responsible</attribute>
            </field>
        </field>
    </record>

    <!-- Request : search by property -->
    <record id="maintenance_request_search_view_inherit" model="ir.ui.view">
        <field name="name">property.maintenance.request.search</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <field name="equipment_id" position="before">
                <field name="property_id"/>
                <field name="tenant_id"/>
            </field>
            <filter name="high_priority" position="after">
                <separator/>
                <filter string="Renter's Fault" name="renters_fault" domain="[('renters_fault', '=', True)]"/>
                <filter string="To Invoice" name="to_invoice" domain="[('renters_fault', '=', True), ('done', '=', True), ('invoice_check', '=', False)]"/>
            </filter>
            <xpath expr="//group" position="inside">
                <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Equipment : property link -->
    <record id="maintenance_equipment_form_view_inherit" model="ir.ui.view">
        <field name="name">property.maintenance.equipment.form</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="property_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="maintenance_equipment_list_view_inherit" model="ir.ui.view">
        <field name="name">property.maintenance.equipment.list</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="property_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="maintenance_equipment_search_view_inherit" model="ir.ui.view">
        <field name="name">property.maintenance.equipment.search</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="property_id"/>
            </field>
            <filter name="category" position="after">
                <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
