<odoo>
	<!--Template For Income Expenditure Report-->
	<template id="report_income_expenditure">
		<t t-call="web.html_container">
				<!-- <t t-call="property_management_ee.property_external_layout"> -->
				<t t-call="web.external_layout"><br/><br/>
					<div class="page">
						<h2>
							<span>
								<center>Income Expenditure Report</center>
							</span>
						</h2>
						<br/>
							<div class="text-center">
								<strong>From:</strong>
								<span t-esc="data['start_date']"/>
								<strong>To:</strong>
								<span t-esc="data['end_date']"/>
							</div>
						<br/>
						<t t-set="currency" t-value="totals['currency_id']"/>
						<table class="table table-sm o_main_table">
							<thead>
								<tr>
									<th class="text-start">Property</th>
									<th class="text-end">Income</th>
									<th class="text-end">Expenditure</th>
								</tr>
							</thead>
							<tbody>
								<tr t-foreach="get_details" t-as="t">
									<td><span t-out="t['property']"/></td>
									<td class="text-end"><span t-out="t['total_income']" t-options="{'widget': 'monetary', 'display_currency': t['currency_id']}"/></td>
									<td class="text-end"><span t-out="t['total_expence']" t-options="{'widget': 'monetary', 'display_currency': t['currency_id']}"/></td>
								</tr>
							</tbody>
							<tfoot>
								<tr class="fw-bold">
									<td>Total</td>
									<td class="text-end"><span t-out="totals['total_in']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
									<td class="text-end"><span t-out="totals['total_ex']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
								</tr>
								<tr class="fw-bold">
									<td>Net Income</td>
									<td colspan="2" class="text-end"><span t-out="totals['total_gr']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
								</tr>
							</tfoot>
						</table>
					</div>
				</t>
		</t>
	</template>

	<record id="action_report_income_expenditure" model="ir.actions.report">
		<field name="name">Income Expenditure</field>
		<field name="model">account.asset</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">property_management_ee.report_income_expenditure</field>
		<field name="report_file">property_management_ee.report_income_expenditure</field>
	</record>
</odoo>
