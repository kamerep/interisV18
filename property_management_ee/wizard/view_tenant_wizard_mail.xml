<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tenant_wizard_mail_form" model="ir.ui.view">
        <field name="name">tenant.wizard.mail.form</field>
        <field name="model">tenant.wizard.mail</field>
        <field name="arch" type="xml">
            <form string="Send Rent Reminders">
                <p class="text-muted">
                    Reminders go to the tenant's email address. With no rent
                    line selected, every unpaid overdue rent line of running
                    tenancies is reminded.
                </p>
                <group>
                    <field name="template_id" required="1"/>
                </group>
                <field name="schedule_ids">
                    <list>
                        <field name="tenancy_id"/>
                        <field name="rel_tenant_id"/>
                        <field name="start_date"/>
                        <field name="amount"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="paid"/>
                    </list>
                </field>
                <footer>
                    <button name="mass_mail_send" string="Send Reminders" type="object" class="btn-primary" icon="fa-envelope"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tenant_mass_mail" model="ir.actions.act_window">
        <field name="name">Send Rent Reminders</field>
        <field name="res_model">tenant.wizard.mail</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="property_management_ee.model_tenancy_rent_schedule"/>
        <field name="binding_view_types">list</field>
    </record>

    <menuitem id="menu_tenant_mass_mail"
              name="Send Rent Reminders"
              parent="property_management_ee.menu_tenant_details_sub"
              action="action_tenant_mass_mail"
              sequence="90"
              groups="property_management_ee.group_property_manager"/>
</odoo>
