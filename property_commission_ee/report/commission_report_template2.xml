<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission details for a period (wizard: Reporting > Commission details report) -->
    <template id="commission_report_template2">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Commission Report</h2>
                    <p class="text-center">
                        <strong>From:</strong> <span t-out="data.get('start_date')"/>
                        <strong class="ms-3">To:</strong> <span t-out="data.get('end_date')"/>
                    </p>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Property</th>
                                <th>Agent</th>
                                <th>Tenancy</th>
                                <th class="text-end">Commission</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="get_datas" t-as="p">
                                <td><span t-out="p['property']"/></td>
                                <td><span t-out="p['agent']"/></td>
                                <td><span t-out="p['tenancy']"/></td>
                                <td class="text-end"><span t-out="p['commission']" t-options="{'widget': 'monetary', 'display_currency': p['currency_id']}"/></td>
                            </tr>
                            <tr t-if="not get_datas">
                                <td colspan="4" class="text-center text-muted">No invoiced commissions in this period.</td>
                            </tr>
                        </tbody>
                        <tfoot t-if="get_datas">
                            <tr class="fw-bold">
                                <td colspan="3">Total</td>
                                <td class="text-end"><span t-out="sum(p['commission'] for p in get_datas)" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
