<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission vendor bills raised for agents in a period -->
    <template id="commission_invoice_owner">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Commission Invoices</h2>
                    <p class="text-center">
                        <strong>From:</strong> <span t-out="data.get('start_date')"/>
                        <strong class="ms-3">To:</strong> <span t-out="data.get('end_date')"/>
                    </p>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Date</th>
                                <th>Agent</th>
                                <th>Property</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="get_data" t-as="inv">
                                <td><span t-out="inv.name"/></td>
                                <td><span t-field="inv.invoice_date"/></td>
                                <td><span t-out="inv.partner_id.name"/></td>
                                <td><span t-out="inv.property_id.name"/></td>
                                <td><span t-field="inv.state"/></td>
                                <td class="text-end"><span t-field="inv.amount_total"/></td>
                            </tr>
                            <tr t-if="not get_data">
                                <td colspan="6" class="text-center text-muted">No commission invoices in this period.</td>
                            </tr>
                        </tbody>
                        <tfoot t-if="get_data">
                            <tr class="fw-bold">
                                <td colspan="5">Total</td>
                                <td class="text-end"><span t-out="sum(get_data.mapped('amount_total_signed')) * -1" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
