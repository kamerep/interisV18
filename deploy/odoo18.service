# systemd unit for an Odoo 18 instance next to other Odoo versions.
# Install: sudo cp deploy/odoo18.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now odoo18
[Unit]
Description=Odoo 18 (Property Management)
After=network.target postgresql.service

[Service]
Type=simple
User=odoo
Group=odoo
ExecStart=/usr/bin/odoo -c /etc/odoo18.conf
Restart=on-failure
KillMode=mixed

[Install]
WantedBy=multi-user.target
